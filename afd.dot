// ============================================================================
//  afd.dot - AFD do analisador lexico do uAssembly
//
//  Gerar imagem:
//      dot -Tpng afd.dot -o afd.png
//
//  Convencoes
//  ----------
//  - Circulo duplo = estado final (aceita o token).
//  - Nos estados finais, qualquer outro caractere NAO consome: e devolvido
//    ao arquivo (scannerDevolver) e o token e emitido.
//  - Estados coloridos (q1, q3, q7) consultam a Tabela de Simbolos com
//    tsBuscar() antes de emitir o token.
//  - Espacos, tabs e quebras de linha em q0 sao ignorados (laco em q0).
// ============================================================================

digraph AFD_uAssembly {

    rankdir=LR;
    fontname="Helvetica";
    labelloc="t";
    label="AFD do analisador lexico - uAssembly";
    nodesep=0.5;
    ranksep=0.9;

    node [fontname="Helvetica", fontsize=11, shape=circle, style=filled, fillcolor="#ffffff"];
    edge [fontname="Helvetica", fontsize=10];

    // ---- seta de entrada -------------------------------------------------
    inicio [shape=point, style=invis, width=0];
    inicio -> q0;

    // ---- estado inicial --------------------------------------------------
    q0 [label="q0"];
    q0 -> q0 [label="espaco, \\t, \\r, \\n"];

    // ---- EOF -------------------------------------------------------------
    qEOF [label="q_eof\nTK_EOF", shape=doublecircle, fillcolor="#e5e7eb"];
    q0 -> qEOF [label="EOF"];

    // ---- comentario --------------------------------------------------------
    qCom [label="q_com\n(comentario)", fillcolor="#f3f4f6"];
    q0 -> qCom [label="#"];
    qCom -> qCom [label="qualquer exceto\n\\n EOF"];
    qCom -> q0 [label="\\n\n(sem token)"];
    qCom -> qEOF [label="EOF"];

    comNote [shape=note, fillcolor="#fef9c3", fontsize=9,
        label="Neste projeto o comentario e\nconsumido no pre-processamento\n(preprocessador.c: remover_comentario),\nantes do arquivo chegar em lexico.c.\nEstado incluido aqui para representar\no caminho pedido no item 3 do enunciado."];
    qCom -> comNote [style=dotted, arrowhead=none];

    // ---- identificador / instrucao / rotulo -----------------------------
    q1 [label="q1\nID ou\nreservada", shape=doublecircle, fillcolor="#bfdbfe"];
    q0 -> q1 [label="[A-Za-z_]"];
    q1 -> q1 [label="[A-Za-z0-9_]"];
    q1 -> qErr [label="outro caractere\n(nao e delimitador)\nERRO_IDENTIFICADOR\n_MALFORMADO", style=dashed];

    // ---- diretiva --------------------------------------------------------
    q2 [label="q2"];
    q3 [label="q3\nDIRETIVA", shape=doublecircle, fillcolor="#bbf7d0"];
    q0 -> q2 [label="."];
    q2 -> q3 [label="[A-Za-z]"];
    q3 -> q3 [label="[A-Za-z]"];
    q3 -> qErr [label="digito ou _ colado\nERRO_DIRETIVA_INVALIDA", style=dashed];

    // ---- string ----------------------------------------------------------
    q4 [label="q4\n(dentro da\nstring)"];
    q5 [label="q5\nSTRING", shape=doublecircle, fillcolor="#fde68a"];
    q0 -> q4 [label="\""];
    q4 -> q4 [label="qualquer exceto\n\" \\ \\n EOF"];
    q4 -> q5 [label="\""];

    // ---- sequencia de escape dentro da string ---------------------------
    qEsc [label="q_esc\n(escape)"];
    q4   -> qEsc [label="\\"];
    qEsc -> q4   [label="n  t  \\  \"  0"];
    qEsc -> qErr [label="outro\nERRO_ESCAPE_INVALIDO", style=dashed];
    qEsc -> qErr [label="\\n: ERRO_STRING_NAO_FECHADA\nEOF: ERRO_STRING_NAO_FECHADA_EOF", style=dashed];

    // ---- registrador -----------------------------------------------------
    q6 [label="q6"];
    q7 [label="q7\nREGISTRADOR", shape=doublecircle, fillcolor="#fbcfe8"];
    q0 -> q6 [label="$"];
    q6 -> q7 [label="[A-Za-z0-9]"];
    q7 -> q7 [label="[A-Za-z0-9]"];

    // ---- numeros (decimal e hexadecimal) ---------------------------------
    q8  [label="q8"];
    q9  [label="q9\nNUM_DEC", shape=doublecircle, fillcolor="#fed7aa"];
    q10 [label="q10\n\"0\"", shape=doublecircle, fillcolor="#fed7aa"];
    q11 [label="q11\n\"0x\""];
    q12 [label="q12\nNUM_HEX", shape=doublecircle, fillcolor="#fed7aa"];

    q0  -> q8  [label="-"];
    q0  -> q10 [label="0"];
    q0  -> q9  [label="[1-9]"];
    q8  -> q9  [label="[1-9]"];
    q8  -> q10 [label="0"];
    q9  -> q9  [label="[0-9]"];
    q10 -> q9  [label="[0-9]"];
    q10 -> q11 [label="x, X"];
    q11 -> q12 [label="[0-9A-Fa-f]"];
    q12 -> q12 [label="[0-9A-Fa-f]"];
    q9  -> qErr [label="letra ou _ colada\nERRO_IDENTIFICADOR\n_MALFORMADO", style=dashed];
    q10 -> qErr [label="letra (exceto x, X)\nou _ colada\nERRO_IDENTIFICADOR\n_MALFORMADO", style=dashed];
    q12 -> qErr [label="letra (nao hex), _ ou .\ncolado\nERRO_NUMERO_INVALIDO", style=dashed];
    q9  -> qErr [label=". colado (ex.: 12.5)\nERRO_NUMERO_INVALIDO", style=dashed];

    // ---- simbolos de pontuacao ------------------------------------------
    q13 [label="q13\nSIMBOLO", shape=doublecircle, fillcolor="#ddd6fe"];
    q0 -> q13 [label=", : ( )"];

    // ---- erro lexico -----------------------------------------------------
    qErr [label="q_erro\nerro lexico", shape=doublecircle, style="filled,dashed", fillcolor="#fecaca"];
    q0  -> qErr [label="outro caractere\nERRO_CARACTERE_INVALIDO", style=dashed];
    q2  -> qErr [label="outro\nERRO_DIRETIVA_INVALIDA", style=dashed];
    q4  -> qErr [label="\\n\nERRO_STRING_NAO_FECHADA", style=dashed];
    q4  -> qErr [label="EOF\nERRO_STRING_NAO_FECHADA_EOF", style=dashed];
    q6  -> qErr [label="outro\nERRO_REGISTRADOR_INVALIDO", style=dashed];
    q8  -> qErr [label="outro ('-' isolado)\nERRO_CARACTERE_INVALIDO", style=dashed];
    q11 -> qErr [label="outro\nERRO_NUMERO_INVALIDO", style=dashed];

    // ---- ligacao com a Tabela de Simbolos --------------------------------
    ts [shape=note, fillcolor="#fef9c3", fontsize=10,
        label="Tabela de Simbolos\ntsBuscar(lexema)\n\nq1: INSTRUCAO -> TK_INSTRUCAO\n     ja inserido    -> TK_ID\n     novo           -> tsInserir + TK_ID\nq3: DIRETIVA valida -> DIR_*\n     nao encontrada -> ERRO_DIRETIVA_INVALIDA\nq7: nomeado ($t0, $sp, ...) -> tsBuscar\n     numerico ($0-$31)    -> validado direto (strtol)\n     invalido -> ERRO_REGISTRADOR_INVALIDO"];
    q1 -> ts [style=dotted, arrowhead=none];
    q3 -> ts [style=dotted, arrowhead=none];
    q7 -> ts [style=dotted, arrowhead=none];
}
